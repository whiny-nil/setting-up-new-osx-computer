# a simple function to list all the worktrees in a repo,
# then show you the list in an interactive picker (fzf),
# then cd to the one you pick
gwcd() {
  local dir
  dir=$(git worktree list --porcelain | grep '^worktree ' | cut -d' ' -f2- | fzf)
  [ -n "$dir" ] && cd "$dir"
}

# GTM feature-branch workflow: create PRs targeting kp-gtm by default.
# Use plain `gh pr create` for anything that legitimately goes to develop.
gtmpr() {
  gh pr create --base kp-gtm "$@"
}
